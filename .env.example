# DeepBook environment configuration
# =====================================
# Copy this file to .env and adjust values for your machine.
# .env is git-ignored — never commit real credentials.

# Root directory for ingested raw and processed datasets.
DEEPBOOK_DATA_ROOT=./data

# Root directory for experiment artifacts (models, metrics, plots).
DEEPBOOK_ARTIFACT_ROOT=./artifacts

# Paid-data gate.
# Must be "false" unless a human has explicitly authorised a purchase.
# When true, DEEPBOOK_MAX_PAID_REQUEST_USD must be set to a positive value.
DEEPBOOK_ALLOW_PAID_DATA=false

# Absolute maximum spend for a single paid-data request in USD.
# Ignored when DEEPBOOK_ALLOW_PAID_DATA is false.
DEEPBOOK_MAX_PAID_REQUEST_USD=0

# Databento API key.
# Only needed for the optional MBO paid-data track.
# Leave empty — no value is needed for the FI-2010 or Binance/Coinbase tracks.
DATABENTO_API_KEY=
